  "type": "module",
  "license": "MIT",
  "author": "Andy Ching <andy@ching.hk>",
  "homepage": "https://github.com/andychinghk01/db-query-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andychinghk01/db-query-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/andychinghk01/db-query-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mysql",
    "postgresql",
    "postgres",
    "sql",
    "database",
    "read-only",
    "ai",
    "llm",
    "bun"
  ],
  "bin": {
    "db-query-mcp": "src/index.ts"
  },
